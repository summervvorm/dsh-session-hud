{
  "name": "dsh-session-hud",
  "version": "1.0.0",
  "description": "Floating session-status HUD for DeepSeek Harness: running, waiting and finished session counts, with completion alerts that clear when the session is opened.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "session",
    "status",
    "hud",
    "overlay",
    "web-ui"
  ],
  "author": "summervvorm",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/summervvorm/dsh-session-hud.git"
  },
  "homepage": "https://github.com/summervvorm/dsh-session-hud#readme",
  "bugs": {
    "url": "https://github.com/summervvorm/dsh-session-hud/issues"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
